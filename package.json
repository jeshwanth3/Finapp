{
  "name": "finapp",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-border debt & cash-flow assistant",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node -e \"const fs=require('fs'); fs.rmSync('.next',{recursive:true,force:true});\" && next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "imapflow": "^1.6.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
